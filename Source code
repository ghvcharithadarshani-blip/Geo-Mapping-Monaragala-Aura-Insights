
library(readr)
library(leaflet)
library(htmlwidgets)
library(htmltools)
library(sf)

base <- "D:/Aura 2/2026/Advanced analysis for trackings/lka_admin_boundaries.shp/"

# 1. Data (MSI_estimated = potential score)
pts <- read_csv(
  "D:/Aura 2/2026/Advanced analysis for trackings/Lion.csv",
  show_col_types = FALSE
)

stopifnot(all(c("DSD", "MSI_estimated", "Latitude", "Longitude") %in% names(pts)))
pts <- pts[complete.cases(pts[, c("MSI_estimated", "Latitude", "Longitude")]), ]

# 2. Boundaries
districts <- st_read(paste0(base, "lka_admin2.shp"), quiet = TRUE) |> st_transform(4326)
dsd       <- st_read(paste0(base, "lka_admin3.shp"), quiet = TRUE) |> st_transform(4326)

is_mon <- function(x) grepl("Mon[ae]ragala", x, ignore.case = TRUE)

mon_district    <- districts[is_mon(districts$adm2_name), ]
other_districts <- districts[!is_mon(districts$adm2_name), ]
mon_dsd         <- dsd[is_mon(dsd$adm2_name), ]

stopifnot(nrow(mon_district) == 1, nrow(mon_dsd) > 0)

bb <- st_bbox(mon_district)

# 3. Colour scale
pal <- colorNumeric(
  palette = c("#D73027", "#FEE08B", "#1A9850"),
  domain  = pts$MSI_estimated
)

# 4. Labels: DSD name + potential score
pts$label <- lapply(
  paste0("<b>", pts$DSD, "</b><br>Potential score: ", round(pts$MSI_estimated, 2)),
  HTML
)

# 5. Map
m <- leaflet(options = leafletOptions(zoomControl = TRUE, zoomSnap = 0.25)) |>
  
  # Other districts: thin grey lines
  addPolygons(
    data = other_districts,
    color = "#9E9E9E", weight = 0.8, opacity = 1,
    fill = FALSE
  ) |>
  
  # Monaragala: pastel orange
  addPolygons(
    data = mon_district,
    color = "black", weight = 1.5, opacity = 1,
    fillColor = "#FFD8B0", fillOpacity = 1
  ) |>
  
  # Monaragala DSD boundaries: thin black
  addPolygons(
    data = mon_dsd,
    color = "black", weight = 0.8, opacity = 1,
    fill = FALSE
  ) |>
  
  # Points with DSD name and potential score always visible
  addCircleMarkers(
    data = pts,
    lng = ~Longitude, lat = ~Latitude,
    radius = 8,
    color = "black", weight = 1,
    fillColor = ~pal(MSI_estimated), fillOpacity = 0.9,
    label = ~label,
    labelOptions = labelOptions(
      noHide = TRUE,
      direction = "bottom",
      textsize = "11px",
      style = list(
        "background" = "rgba(255,255,255,0.8)",
        "padding" = "2px 4px",
        "border" = "none"
      )
    )
  ) |>
  
  addLegend(
    position = "bottomright",
    pal = pal, values = pts$MSI_estimated,
    title = "Potential score"
  ) |>
  
  fitBounds(bb[["xmin"]], bb[["ymin"]], bb[["xmax"]], bb[["ymax"]])

# 6. Save and show
setwd("D:/Aura 2/2026/Advanced analysis for trackings")
saveWidget(m, "Monaragala_DSD_Potential_Map.html", selfcontained = TRUE)
m

